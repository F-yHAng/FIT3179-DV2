{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 260,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "#fbfaf6",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#233c32",
      "labelColor": "#52645b",
      "domain": false,
      "tickColor": "#cfcfc1",
      "gridColor": "#e5e5dc",
      "gridOpacity": 0.75,
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "orient": "bottom",
      "labelColor": "#233c32",
      "titleColor": "#233c32",
      "padding": 5,
      "offset": 12
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "fontWeight": 500,
      "color": "#233c32"
    }
  },
  "description": "Published national age composition of Indigenous-language home users. Segment widths normalise rounded published percentages; tooltip retains original values.",
  "data": {
    "url": "age-profile.json"
  },
  "mark": {
    "type": "bar",
    "height": 32
  },
  "encoding": {
    "y": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        2006,
        2011,
        2016,
        2021
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "ticks": false,
        "labelFontWeight": 600
      }
    },
    "x": {
      "field": "percent",
      "type": "quantitative",
      "stack": "normalize",
      "axis": {
        "title": "Share of recorded home users",
        "format": ".0%",
        "values": [
          0,
          0.25,
          0.5,
          0.75,
          1
        ]
      }
    },
    "color": {
      "field": "age",
      "type": "nominal",
      "scale": {
        "domain": [
          "0–14",
          "15–24",
          "25–44",
          "45–64",
          "65+"
        ],
        "range": [
          "#236652",
          "#6c9e87",
          "#a9c4a3",
          "#d4c398",
          "#ae785b"
        ]
      },
      "legend": {
        "title": "Age (years)"
      }
    },
    "order": {
      "field": "age",
      "type": "ordinal",
      "sort": "ascending"
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Census",
        "format": "d"
      },
      {
        "field": "age",
        "type": "nominal",
        "title": "Age"
      },
      {
        "field": "percent",
        "type": "quantitative",
        "title": "Published composition (%)",
        "format": ".1f"
      },
      {
        "field": "users",
        "type": "quantitative",
        "title": "Home users in age group",
        "format": ",.0f"
      }
    ]
  }
}
