{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "#fbfaf6",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#233c32",
      "labelColor": "#52645b",
      "domain": false,
      "tickColor": "#cfcfc1",
      "gridColor": "#e5e5dc",
      "gridOpacity": 0.75,
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "orient": "bottom",
      "labelColor": "#233c32",
      "titleColor": "#233c32",
      "padding": 5,
      "offset": 12
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "fontWeight": 500,
      "color": "#233c32"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  "description": "Home-use share in 2021, grouped into five colour bands. Northern Territory: 58.5%, far above every other state and territory. Hover or tap a state to highlight it in all three linked charts.",
  "layer": [
    {
      "data": {
        "url": "states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states_2021"
        }
      },
      "transform": [
        {
          "lookup": "properties.STE_CODE21",
          "from": {
            "data": {
              "url": "states-2021.json"
            },
            "key": "state_code",
            "fields": [
              "state",
              "short",
              "users",
              "percent",
              "population"
            ]
          }
        },
        {
          "calculate": "datum.percent < 2 ? '0–2%' : datum.percent < 5 ? '2–5%' : datum.percent < 10 ? '5–10%' : datum.percent < 20 ? '10–20%' : '50%+'",
          "as": "share_band"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fbfaf6",
        "strokeWidth": 1.3
      },
      "encoding": {
        "color": {
          "field": "share_band",
          "type": "ordinal",
          "scale": {
            "domain": [
              "0–2%",
              "2–5%",
              "5–10%",
              "10–20%",
              "50%+"
            ],
            "range": [
              "#edf8e9",
              "#bae4b3",
              "#74c476",
              "#31a354",
              "#00441b"
            ]
          },
          "legend": {
            "title": "Home-use share",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "symbolType": "square",
            "symbolSize": 150,
            "labelLimit": 90
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "title": "Indigenous residents (%)",
            "format": ".1f"
          },
          {
            "field": "users",
            "type": "quantitative",
            "title": "Home users",
            "format": ",.0f"
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "Indigenous residents",
            "format": ",.0f"
          }
        ],
        "opacity": {
          "condition": {
            "test": "!highlightState || datum.short === highlightState",
            "value": 1
          },
          "value": 0.3
        },
        "stroke": {
          "condition": {
            "test": "datum.short === highlightState",
            "value": "#233c32"
          },
          "value": "#fbfaf6"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.short === highlightState",
            "value": 3
          },
          "value": 1.3
        }
      }
    },
    {
