          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "short",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.short === 'NT'",
            "value": "white"
          },
          "value": "#10251b"
        },
        "opacity": {
          "condition": {
            "test": "!highlightState || datum.short === highlightState",
            "value": 1
