{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "#fbfaf6",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#233c32",
      "labelColor": "#52645b",
      "domain": false,
      "tickColor": "#cfcfc1",
      "gridColor": "#e5e5dc",
      "gridOpacity": 0.75,
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "orient": "bottom",
      "labelColor": "#233c32",
      "titleColor": "#233c32",
      "padding": 5,
      "offset": 12
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "fontWeight": 500,
      "color": "#233c32"
    }
  },
  "description": "Ranks among 196 common named labels, showing the 2021 top eight. Ranking universe is fixed before display filtering.",
  "data": {
    "url": "ranks.json"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          2010.5,
          2027
        ]
      },
      "axis": {
        "title": null,
        "values": [
          2011,
          2016,
          2021
        ],
        "format": "d",
        "grid": false
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {
        "domain": [
          1,
          10
        ],
        "reverse": true,
        "zero": false
      },
      "axis": {
        "title": "Rank in the same 196 labels",
        "tickMinStep": 1,
        "grid": true
      }
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Yumplatok",
          "Kriol",
          "Djambarrpuyngu",
          "Pitjantjatjara",
          "Warlpiri",
          "Murrinh Patha",
          "Tiwi",
          "Alyawarr"
        ],
        "range": [
          "#236652",
          "#80593d",
          "#405f8b",
          "#4f7354",
          "#805d79",
          "#7f682e",
          "#416367",
          "#88574f"
        ]
      },
      "legend": null
    },
    "opacity": {
      "condition": {
        "param": "language_hover",
        "value": 1
      },
      "value": 0.2
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.2
      },
      "encoding": {
        "detail": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "params": [
        {
          "name": "language_hover",
          "select": {
            "type": "point",
            "fields": [
              "label"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70
      },
      "encoding": {
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Named category"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Census",
            "format": "d"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": "d"
          },
          {
            "field": "users",
            "type": "quantitative",
            "title": "Indigenous home users",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2021"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
