{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 380,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "#fbfaf6",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#233c32",
      "labelColor": "#52645b",
      "domain": false,
      "tickColor": "#cfcfc1",
      "gridColor": "#e5e5dc",
      "gridOpacity": 0.75,
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "orient": "bottom",
      "labelColor": "#233c32",
      "titleColor": "#233c32",
      "padding": 5,
      "offset": 12
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "fontWeight": 500,
      "color": "#233c32"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ]
  },
  "description": "Circle area represents state-level 2021 Indigenous home-use counts. Interior anchors place aggregate symbols, not individual users.",
  "layer": [
    {
      "data": {
        "url": "states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states_2021"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7e7da",
        "stroke": "#fbfaf6",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "states-2021.json"
      },
      "mark": {
        "type": "circle",
        "color": "#236652",
        "opacity": 0.75,
        "stroke": "#fbfaf6",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "users",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40000
            ],
            "range": [
              0,
              2500
            ]
          },
          "legend": {
            "title": "Home users · circle area",
            "values": [
              1000,
              10000,
              35000
            ],
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "users",
            "type": "quantitative",
            "title": "Home users",
            "format": ",.0f"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "title": "Indigenous residents (%)",
            "format": ".1f"
          }
        ]
      }
    },
